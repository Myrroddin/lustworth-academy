# Built Ren'Py archives
*.rpa

# Ren'Py logs and crash output
log.txt
errors.txt
traceback.txt
stdout.txt
stderr.txt
*.log

# Runtime save/cache state
/cache/
/saves/
game/cache/
game/saves/

# Auto-generated Ren'Py source/runtime directories
renpy/
lib/

# Common Ren'Py build/export output directories
/build/
/dist/
/packages/
/web-cache/

# Root-only launcher/runtime files from local game installs or exports
/LustworthAcademy*.*
/game live/

